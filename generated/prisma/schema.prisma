// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  COORDENADOR
  DIRETOR
  PROFESSOR
  MONITOR
}

enum TipoMaterial {
  LINK
  PDF
  SLIDE
  IMAGEM
}

enum TipoEvento {
  AULA
  FERIADO
  CANCELADA
  ESPECIAL
}

enum EstadoPresenca {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}

enum CursoSorteio {
  SMARTPHONE
  COMPUTADOR
}

enum TipoPergunta {
  SHORT_TEXT
  PARAGRAPH
  MULTIPLE_CHOICE
  CHECKBOX
}

// ---------------------------------------------------------------------------
// Auth (NextAuth) — mantidos do schema original
// ---------------------------------------------------------------------------

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// User — unifica Coordenador, Diretor, Professor e Monitor
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  nome            String
  email           String    @unique
  senha           String
  senhaAlteradaEm DateTime?
  matricula       String    @unique
  role            Role
  image           String?
  emailVerified   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Auth
  accounts Account[]
  sessions Session[]

  // Relações de turma
  turmasProfessor  ProfessorTurma[]
  turmasMonitor    MonitorTurma[]
  vinculosSemestre VinculoEquipeSemestre[]

  // Conteúdo
  avisos                  Aviso[]
  anotacoes               Anotacao[]
  formulariosCriados      Formulario[]           @relation("AutorFormulario")
  redefinicoesSolicitadas PasswordResetRequest[] @relation("SolicitanteRedefinicao")
  redefinicoesRecebidas   PasswordResetRequest[] @relation("DestinatarioRedefinicao")

  // Presença de equipe
  presencasMonitor                PresencaMonitor[]
  presencasProfessor              PresencaProfessor[]
  apostilasResponsavel            ResponsavelApostila[]
  materiaisAtualizacaoResponsavel ResponsavelMaterialAtualizacao[]
}

// O código é persistido somente como hash e expira após o uso.
model PasswordResetRequest {
  id            String    @id @default(cuid())
  userId        String
  requestedById String
  codigoHash    String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  user        User @relation("DestinatarioRedefinicao", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy User @relation("SolicitanteRedefinicao", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([requestedById])
}

// ---------------------------------------------------------------------------
// Semestre
// ---------------------------------------------------------------------------

model Semestre {
  id        String   @id @default(cuid())
  codigo    String   @unique // Ex: "2026.1"
  ativo     Boolean  @default(false)
  createdAt DateTime @default(now())

  turmas               Turma[]
  alunos               Aluno[]
  candidatos           Candidato[]
  vinculosEquipe       VinculoEquipeSemestre[]
  semanasImpressao     SemanaImpressao[]
  materiaisAtualizacao MaterialAtualizacao[]
}

// ---------------------------------------------------------------------------
// Controle de impressão de apostilas
// ---------------------------------------------------------------------------

model SemanaImpressao {
  id            String    @id @default(cuid())
  semestreId    String
  numero        Int
  dataAula      DateTime?
  aulaRealizada Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  semestre  Semestre            @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  apostilas ApostilaImpressao[]

  @@unique([semestreId, numero])
  @@index([semestreId])
}

model ApostilaImpressao {
  id          String    @id @default(cuid())
  semanaId    String
  titulo      String
  curso       String
  dataEntrega DateTime?
  pronta      Boolean   @default(false)
  impressa    Boolean   @default(false)
  qtdImpressa Int       @default(0)
  qtdAlvo     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  semana       SemanaImpressao       @relation(fields: [semanaId], references: [id], onDelete: Cascade)
  responsaveis ResponsavelApostila[]

  @@index([semanaId])
}

model ResponsavelApostila {
  apostilaId String
  userId     String

  apostila ApostilaImpressao @relation(fields: [apostilaId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([apostilaId, userId])
  @@index([userId])
}

model MaterialAtualizacao {
  id            String    @id @default(cuid())
  semestreId    String
  curso         String
  titulo        String
  dataEntrega   DateTime?
  revisado      Boolean   @default(false)
  precisaAjuste Boolean   @default(false)
  ajustado      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  semestre     Semestre                         @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  responsaveis ResponsavelMaterialAtualizacao[]

  @@index([semestreId])
}

model ResponsavelMaterialAtualizacao {
  materialId String
  userId     String

  material MaterialAtualizacao @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([materialId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Turma
// ---------------------------------------------------------------------------

model Turma {
  id           String  @id @default(cuid())
  titulo       String
  sala         String?
  horario      String?
  cor          String  @default("#1A73E8")
  corDestaque  String  @default("#ea580c")
  corFundo     String  @default("#f8fafc")
  corTexto     String  @default("#0f172a")
  corTitulo    String  @default("#ffffff")
  corDescricao String  @default("#64748b")
  fonte        String  @default("SANS")
  semestreId   String

  semestre Semestre @relation(fields: [semestreId], references: [id], onDelete: Cascade)

  // Pessoas
  professores ProfessorTurma[]
  monitores   MonitorTurma[]
  alunos      AlunoTurma[]

  // Conteúdo
  materiais Material[]
  eventos   EventoCalendario[]
  avisos    Aviso[]
  anotacoes Anotacao[]

  // Presença
  presencas RegistroPresenca[]

  @@index([semestreId])
}

// ---------------------------------------------------------------------------
// Tabelas de junção (many-to-many)
// ---------------------------------------------------------------------------

model ProfessorTurma {
  userId  String
  turmaId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([userId, turmaId])
}

model MonitorTurma {
  userId  String
  turmaId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([userId, turmaId])
}

model AlunoTurma {
  alunoId String
  turmaId String

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([alunoId, turmaId])
}

// ---------------------------------------------------------------------------
// Aluno — registro demográfico (não faz login)
// ---------------------------------------------------------------------------

model Aluno {
  id                String          @id @default(cuid())
  semestreId        String
  nome              String
  dataNascimento    DateTime
  cpf               String
  alunoOrigemId     String?
  etapaTrilha       String?
  statusMatricula   StatusMatricula @default(ATIVO)
  corRaca           String
  identidadeGenero  String
  lgbtqiapn         String
  telefone          String?
  contatoEmergencia String?
  email             String?
  escolaridade      String
  cuidaTerceiros    Boolean         @default(false)

  // Trabalho (condicionais)
  trabalha       Boolean @default(false)
  trabalhoLocal  String?
  trabalhoFuncao String?

  // Estudo (condicionais)
  estuda      Boolean @default(false)
  estudoLocal String?
  estudoCurso String?

  // Saúde (condicionais)
  problemaSaude           Boolean @default(false)
  problemaSaudeQual       String?
  necessidadeEspecial     Boolean @default(false)
  necessidadeEspecialQual String?

  // Infraestrutura (condicionais)
  acessoInternet    Boolean @default(false)
  temComputador     Boolean @default(false)
  temSmartphone     Boolean @default(false)
  sistemaSmartphone String?

  createdAt DateTime @default(now())

  semestre      Semestre        @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  alunoOrigem   Aluno?          @relation("ContinuidadesAluno", fields: [alunoOrigemId], references: [id], onDelete: SetNull)
  continuidades Aluno[]         @relation("ContinuidadesAluno")
  turmas        AlunoTurma[]
  presencas     PresencaAluno[]

  @@unique([cpf, semestreId])
  @@index([semestreId])
  @@index([cpf])
  @@index([alunoOrigemId])
}

enum StatusMatricula {
  ATIVO
  CONCLUIDO
  DESISTENTE
  TRANSFERIDO
}

model VinculoEquipeSemestre {
  userId     String
  semestreId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semestre Semestre @relation(fields: [semestreId], references: [id], onDelete: Cascade)

  @@id([userId, semestreId])
  @@index([semestreId])
}

// ---------------------------------------------------------------------------
// Material
// ---------------------------------------------------------------------------

model Material {
  id        String       @id @default(cuid())
  turmaId   String
  titulo    String
  tipo      TipoMaterial
  url       String
  createdAt DateTime     @default(now())

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([turmaId])
}

// ---------------------------------------------------------------------------
// Evento do Calendário
// ---------------------------------------------------------------------------

model EventoCalendario {
  id      String     @id @default(cuid())
  turmaId String
  data    DateTime
  titulo  String
  tipo    TipoEvento

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([turmaId, data])
}

// ---------------------------------------------------------------------------
// Aviso (Posts da turma)
// ---------------------------------------------------------------------------

model Aviso {
  id        String   @id @default(cuid())
  turmaId   String
  autorId   String
  texto     String
  imagemUrl String?
  linkUrl   String?
  fixado    Boolean  @default(false)
  createdAt DateTime @default(now())

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  autor User  @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([turmaId])
}

// ---------------------------------------------------------------------------
// Anotação (notas privadas do professor/monitor)
// ---------------------------------------------------------------------------

model Anotacao {
  id        String   @id @default(cuid())
  turmaId   String
  autorId   String
  titulo    String
  conteudo  String
  createdAt DateTime @default(now())

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  autor User  @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([turmaId])
}

// ---------------------------------------------------------------------------
// Presença — dividida em Alunos e Monitores
// ---------------------------------------------------------------------------

model RegistroPresenca {
  id      String   @id @default(cuid())
  turmaId String
  data    DateTime

  turma       Turma               @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  alunos      PresencaAluno[]
  monitores   PresencaMonitor[]
  professores PresencaProfessor[]

  @@unique([turmaId, data])
  @@index([turmaId])
}

model PresencaAluno {
  id         String         @id @default(cuid())
  registroId String
  alunoId    String
  estado     EstadoPresenca

  registro RegistroPresenca @relation(fields: [registroId], references: [id], onDelete: Cascade)
  aluno    Aluno            @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([registroId, alunoId])
}

model PresencaMonitor {
  id         String         @id @default(cuid())
  registroId String
  monitorId  String
  estado     EstadoPresenca

  registro RegistroPresenca @relation(fields: [registroId], references: [id], onDelete: Cascade)
  monitor  User             @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([registroId, monitorId])
}

model PresencaProfessor {
  id          String         @id @default(cuid())
  registroId  String
  professorId String
  estado      EstadoPresenca

  registro  RegistroPresenca @relation(fields: [registroId], references: [id], onDelete: Cascade)
  professor User             @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([registroId, professorId])
}

// ---------------------------------------------------------------------------
// Candidato (Sorteio)
// ---------------------------------------------------------------------------

model Candidato {
  id             String       @id @default(cuid())
  semestreId     String
  ficha          String
  nome           String
  dataNascimento DateTime
  cpf            String
  telefone       String
  emergencia     String
  curso          CursoSorteio
  createdAt      DateTime     @default(now())

  semestre Semestre @relation(fields: [semestreId], references: [id], onDelete: Cascade)

  @@index([semestreId])
}

// ---------------------------------------------------------------------------
// Formulário (Builder)
// ---------------------------------------------------------------------------

model Formulario {
  id                  String                 @id @default(cuid())
  titulo              String
  descricao           String?
  slug                String                 @unique
  conteudo            Json // definição inteira do formulário; evita salvar rascunhos parciais em várias tabelas
  publicado           Boolean                @default(false)
  modoResposta        ModoRespostaFormulario @default(ANONIMO)
  limitarPorNavegador Boolean                @default(false)
  configuracao        Json?
  visibilidade        VisibilidadeFormulario @default(COMPARTILHADO)
  autorId             String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  perguntas Pergunta[]
  respostas FormularioResposta[]
  autor     User?                @relation("AutorFormulario", fields: [autorId], references: [id], onDelete: SetNull)

  @@index([visibilidade, updatedAt])
  @@index([autorId])
}

model FormularioResposta {
  id                  String   @id @default(cuid())
  formularioId        String
  respostas           Json // mapa { perguntaId: resposta }, preservando a resposta exatamente como enviada
  nomeRespondente     String?
  identificadorCookie String?
  pontuacao           Int?
  createdAt           DateTime @default(now())

  formulario Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)

  @@unique([formularioId, identificadorCookie])
  @@index([formularioId, createdAt])
}

enum ModoRespostaFormulario {
  ANONIMO
  IDENTIFICADO_POR_COOKIE
}

enum VisibilidadeFormulario {
  COMPARTILHADO
  DIRETORIA
}

model Pergunta {
  id           String       @id @default(cuid())
  formularioId String
  titulo       String
  tipo         TipoPergunta
  obrigatoria  Boolean      @default(false)
  ordem        Int          @default(0)

  formulario Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  opcoes     Opcao[]

  @@index([formularioId])
}

model Opcao {
  id         String @id @default(cuid())
  perguntaId String
  texto      String
  ordem      Int    @default(0)

  pergunta Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)

  @@index([perguntaId])
}
